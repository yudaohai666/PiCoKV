+def _is_dataclass_output(output: Any) -> bool:
+    return dataclasses.is_dataclass(output) and not isinstance(output, type)
+
+
+def _dataclass_tensor_fields(output: Any):
+    """(name, tensor) for the dataclass's non-empty tensor fields."""
+    for f in dataclasses.fields(output):
+        val = getattr(output, f.name)
+        if torch.is_tensor(val) and val.dim() > 0:
+            yield f.name, val
