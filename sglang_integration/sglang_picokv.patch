+def _picokv_stable_order() -> bool:
+    """PiCoKV decode keeps per-row window / packed buffers at the batch row
+    positions: an order-preserving filter shifts every row after a finished
+    one (O(B) row copies per finish), a hole fill moves one row per hole.
+    PICOKV_STABLE_ORDER=0 keeps sglang's order-preserving filter."""
+    global _PICOKV_STABLE_ORDER
+    if _PICOKV_STABLE_ORDER is None:
+        from sglang.srt.runtime_context import attention_backends
+
+        _PICOKV_STABLE_ORDER = (
+            attention_backends()[1] == "picokv"
+            and os.environ.get("PICOKV_STABLE_ORDER", "1") != "0"
+        )
+    return _PICOKV_STABLE_ORDER
+
+
+def _hole_fill_order(keep_indices: List[int]) -> List[int]:
+    """Order the kept rows so each one stays at its old position when that
+    position survives the shrink; rows past the new size fill the vacated
+    positions in order. Same rows (only the order differs), e.g.
+    [0, 2, 3, 5] of 6 rows -> [0, 5, 2, 3] (row 5 fills hole 1)."""
+    m = len(keep_indices)
+    kept = set(keep_indices)
+    movers = iter(sorted(i for i in keep_indices if i >= m))
+    return [p if p in kept else next(movers) for p in range(m)]
+
