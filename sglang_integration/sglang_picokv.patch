index b5ef4ed9..ab0cbda7 100644
--- a/python/sglang/srt/arg_groups/attention_hook.py
+++ b/python/sglang/srt/arg_groups/attention_hook.py
@@ -609,3 +609,184 @@ def handle_deterministic_inference(server_args: Any):
                 logger.warning(
                     "NCCL_ALGO is set to 'allreduce:tree', the NCCL channel count is pinned, and custom and symmetric-memory all reduce are disabled for deterministic inference when TP size > 1."
                 )
+
+
+def handle_picokv_serving_constraints(server_args: Any):
+    """Serving constraints of the picokv attention backend.
+
+    PiCoKV keeps one compressed cache per request inside the backend; the
+    token-level KV pool is a no-op. Features that read or share KV through
+    that pool would silently lose context, so the defaults are turned off
+    here (radix cache, mixed chunked prefill, the full decode graph) and
+    explicit combinations without a working path are rejected. Chunked
+    prefill stays on: the backend's host chunk stage makes it exact. Runs
+    before handle_gpu_memory_settings so the memory budget sees the resolved
+    chunked_prefill_size.
+    """
+    cfg = resolving_view(server_args)
+    backends = attention_backends_of(cfg)
+    if "picokv" not in backends:
+        return
+    src = "_handle_picokv_serving_constraints"
+    if backends != ("picokv", "picokv"):
+        raise ValueError(
+            "picokv must serve both prefill and decode (got prefill=%r, "
+            "decode=%r): the compressed cache is built by the picokv prefill."
+            % backends
+        )
+    for name, bad in (
+        ("speculative decoding", cfg.speculative_algorithm is not None),
+        ("DP attention", cfg.enable_dp_attention),
+        ("pipeline parallelism", cfg.pp_size > 1),
+        ("decode context parallelism", cfg.dcp_size > 1),
+        ("hierarchical cache", cfg.enable_hierarchical_cache),
+        ("PD disaggregation", cfg.disaggregation_mode != "null"),
+        # a session turn extends the previous turn's KV, which the no-op
+        # pool does not hold (the backend's cache is per request)
+        ("streaming sessions", cfg.enable_streaming_session),
+        # a CP rank's prefill holds a slice of the sequence; the backend's
+        # cache is built from the whole prompt on one rank
+        ("prefill context parallelism",
+         bool(getattr(cfg, "enable_prefill_cp", False))
+         or (getattr(cfg, "attn_cp_size", 1) or 1) > 1),
+        ("diffusion LLM decoding", getattr(cfg, "dllm_algorithm", None) is not None),
+        # a multiplexed prefill and decode share the backend's per-request
+        # state from two streams
+        ("PD multiplexing", bool(getattr(cfg, "enable_pdmux", False))),
+        # MLP sync pads the attention batch with idle rows the backend
+        # would serve as req row 0; TBO splits one batch in two forwards
+        ("MoE all-to-all backends",
+         getattr(cfg, "moe_a2a_backend", None) not in (None, "none")),
+        ("--moe-dense-tp-size", getattr(cfg, "moe_dense_tp_size", None) is not None),
+        ("two-batch overlap", bool(getattr(cfg, "enable_two_batch_overlap", False))),
+        # the canary audits the token pool, which picokv does not write
+        ("KV canary", getattr(cfg, "kv_canary", None) not in (None, "none")),
+    ):
+        if bad:
+            raise ValueError(f"picokv attention backend does not support {name}")
+    # env enums: an unknown value would silently pick a default path
+    for env, default, ok in (
+        ("PICOKV_PREFILL", "fi", ("fi", "sdpa")),
+        ("PICOKV_CHUNK_STAGE", "host", ("host", "off")),
+        ("PICOKV_RADIX", "off", ("off", "host")),
+        ("PICOKV_LOST", "abort", ("abort", "keep")),
+    ):
+        val = os.environ.get(env, default).strip().lower()
+        if val not in ok:
+            raise ValueError(f"{env}={val!r}: expected one of {', '.join(ok)}")
+    # not validated with the per-layer breakable decode graph (it re-enters
+    # the backend's Python each layer)
+    if cfg.enable_torch_compile:
+        logger.warning("picokv: torch.compile disabled (not validated with the backend).")
+        declare_resolution(server_args, src, enable_torch_compile=False)
+    if cfg.enable_memory_saver:
+        logger.warning(
+            "picokv: release_memory_occupation frees the weights only: the "
+            "backend's caches, windows and chunk stage are not in the memory "
+            "saver's KV region (the token pool is a no-op)."
+        )
+    # the backend keeps its own K/V (bf16 dense window + key_bits/value_bits
+    # compressed, from the projection config); the pool's dtype is unused
+    if cfg.kv_cache_dtype not in (None, "auto", "bf16", "bfloat16"):
+        logger.warning(
+            "picokv: --kv-cache-dtype %s ignored (the backend stores a bf16 dense "
+            "window and a compressed cache sized by the projection's bits).",
+            cfg.kv_cache_dtype,
+        )
+        declare_resolution(server_args, src, kv_cache_dtype="auto")
+
+    staged = (
+        os.environ.get("PICOKV_CHUNK_STAGE", "host").strip().lower() != "off"
+        and os.environ.get("PICOKV_PREFILL", "fi").strip().lower() != "sdpa"
+    )
+    # radix cache: a hit skips the prefix, which the per-request compressed
+    # cache does not hold. PICOKV_RADIX=host keeps it on through the picokv
+    # radix backend (mem_cache/picokv_radix_cache.py: tree nodes own the
+    # prefix's raw K/V in the host stage; a hit streams it back, exact).
+    if not cfg.disable_radix_cache:
+        radix = os.environ.get("PICOKV_RADIX", "off").strip().lower()
+        if radix == "host" and staged:
+            if cfg.page_size not in (None, 1):
+                raise ValueError(
+                    "picokv with PICOKV_RADIX=host needs page_size 1 (host K/V "
+                    f"per token), got {cfg.page_size}"
+                )
+            if cfg.radix_cache_backend not in (None, "picokv"):
+                raise ValueError(
+                    "picokv with PICOKV_RADIX=host needs --radix-cache-backend "
+                    f"picokv, got {cfg.radix_cache_backend!r}"
+                )
+            import sglang.srt.mem_cache.picokv_radix_cache  # noqa: F401 (registers)
+
+            declare_resolution(server_args, src, radix_cache_backend="picokv")
+        else:
+            logger.warning(
+                "picokv: radix cache disabled (the prefix KV is compressed per "
+                "request; a radix hit would skip the prefix in the cache). "
+                "PICOKV_RADIX=host keeps it through host K/V."
+            )
+            declare_resolution(server_args, src, disable_radix_cache=True)
+
+    # chunked prefill: exact through the backend's chunk stage (continuation
+    # chunks attend the staged raw prefix ++ chunk; the compressed cache is
+    # merged per chunk), so SGLang's chunk size is kept (unset: the GPU
+    # default handle_gpu_memory_settings picks).
+    # PICOKV_CHUNK_STAGE=off (or PICOKV_PREFILL=sdpa, no stage): a
+    # continuation chunk would attend only itself, so chunking is turned off
+    # unless PICOKV_ALLOW_CHUNKED_PREFILL=1. A chunk size >= context_len
+    # never splits a prompt, so it is kept unless the memory budget is
+    # auto-sized (that estimate scales with it).
+    chunk = cfg.chunked_prefill_size
+    context_len = model_config_of(server_args).context_len
+    allow = staged or os.environ.get("PICOKV_ALLOW_CHUNKED_PREFILL", "0") == "1"
+    if chunk == 0 or (chunk is None and not staged):
+        declare_resolution(server_args, src, chunked_prefill_size=-1)
+    elif chunk is None:
+        pass  # the GPU default of handle_gpu_memory_settings
+    elif 0 < chunk < context_len and not allow:
+        logger.warning(
+            "picokv: chunked prefill (chunked_prefill_size=%d < context_len=%d) "
+            "disabled (no chunk stage: PICOKV_CHUNK_STAGE=off or "
+            "PICOKV_PREFILL=sdpa); set PICOKV_ALLOW_CHUNKED_PREFILL=1 to keep it.",
+            chunk,
+            context_len,
+        )
+        declare_resolution(server_args, src, chunked_prefill_size=-1)
+    elif chunk >= context_len and cfg.mem_fraction_static is None:
+        declare_resolution(server_args, src, chunked_prefill_size=-1)
+    if cfg.enable_mixed_chunk:
+        logger.warning("picokv: mixed chunked prefill disabled.")
+        declare_resolution(server_args, src, enable_mixed_chunk=False)
+
+    # decode: only the breakable graph re-enters the backend per layer.
+    # prefill: forward_extend has no eager break, a captured prefill graph
+    # would replay stale cache writes.
+    locked = getattr(server_args, "_cuda_graph_config_locked", set())
+    decode = cfg.cuda_graph_config.decode.backend
+    if decode not in (Backend.BREAKABLE, Backend.DISABLED):
+        if (Phase.DECODE, "backend") in locked:
+            raise ValueError(
+                f"picokv supports decode CUDA graph backend 'breakable' or "
+                f"'disabled', got {decode!r}"
+            )
+        declare_resolution(
+            server_args,
+            src,
+            cuda_graph_config=with_phase(
+                cfg.cuda_graph_config, Phase.DECODE, backend=Backend.BREAKABLE
+            ),
+        )
+        cfg = resolving_view(server_args)
+    prefill = cfg.cuda_graph_config.prefill.backend
+    if prefill != Backend.DISABLED:
+        if (Phase.PREFILL, "backend") in locked:
+            raise ValueError(
+                f"picokv supports no prefill CUDA graph, got {prefill!r}"
+            )
+        declare_resolution(
+            server_args,
+            src,
+            cuda_graph_config=with_phase(
+                cfg.cuda_graph_config, Phase.PREFILL, backend=Backend.DISABLED
+            ),
+        )
