__pycache__/
*.py[cod]
*.so
*.o
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local CUDA/JIT build outputs.
build/
dist/
*.cu.o

# Large local artifacts should stay out of commits unless explicitly needed.
*.pt
*.pth
*.safetensors

# Generated offline projection artifacts.
offline_projection/projections/*
!offline_projection/projections/Llama-3.1-8B-Instruct_k320_v320_nowhiten.pt
!offline_projection/projections/Llama-3.1-8B-Instruct_k320_v256_nowhiten.pt
!offline_projection/projections/Llama-3.1-8B-Instruct_k256_v256_nowhiten.pt
!offline_projection/projections/Qwen3-8B_k320_v256_nowhiten.pt
!offline_projection/projections/Qwen3-8B_k320_v256_whiten.pt
!offline_projection/projections/Qwen3-8B_k320_v320_nowhiten.pt
!offline_projection/projections/Qwen3-8B_k320_v320_whiten.pt

# Generated run logs.
*.log

# Generated benchmark results.
results/

# Generated profiler traces
results/efficiency/prof/
offline_projection/data/proof-pile.json
offline_projection/data/codeparrot.json
offline_projection/data/pg19.json

# Vendored third-party sources. Checked out at a pinned tag by install.sh and
# stripped of their own .git so they never become nested repositories -- the
# commit they came from is recorded in 3rd/<name>.version instead.
3rd/
/benchmarks/**/launch*.sh
