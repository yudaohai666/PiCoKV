__pycache__/
*.py[cod]
*.so
*.o
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local CUDA/JIT build outputs.
build/
dist/
*.cu.o

# Large local artifacts should stay out of commits unless explicitly needed.
*.pt
*.pth
*.safetensors

# Offline block-32 projections are the exception: they are the method's shipped
# artifact rather than a local build product, so a run has to be reproducible
# from the repo alone. Scratch fits are still excluded -- a partially fitted
# file has the right shape and zeros where heads never ran, so it fails
# silently rather than loudly if it ever reaches a benchmark.
!offline_projection/projections/*.pt
offline_projection/projections/smoke_*.pt
offline_projection/projections/*_plain.pt
offline_projection/projections/*.progress.pt

# Generated run logs.
*.log

# Generated profiler traces
results/efficiency/prof/
offline_projection/data/proof-pile.json
offline_projection/data/codeparrot.json
offline_projection/data/pg19.json
